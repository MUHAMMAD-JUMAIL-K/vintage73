generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                    @id(map: "User_pkey") @default(autoincrement())
  username                String                 @unique(map: "User_username_key")
  password                String
  role                    String                 @default("user")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  allowedModules          Json?
  name                    String?
  branchId                Int?
  incentivePercentage     Decimal                @default(0) @db.Decimal(5, 2)
  imageUrl                String?
  weeklyOff               String?                @default("Sunday")
  isActive                Boolean                @default(true)
  adminId                 Int?
  attendance              Attendance[]
  crmTasks                CRMTask[]
  receivedMessages        ChatMessage[]          @relation("ReceivedMessages")
  sentMessages            ChatMessage[]          @relation("SentMessages")
  deals                   Deal[]
  employeeProfile         EmployeeProfile?
  approvedLeaves          LeaveRequest[]         @relation("LeaveApprover")
  leaveRequests           LeaveRequest[]
  reviewedMissPunches     MissPunchRequest[]     @relation("ReviewedMissPunch")
  missPunchRequests       MissPunchRequest[]
  notifications           Notification[]
  payrolls                Payroll[]
  approvedAdvances        SalaryAdvance[]        @relation("ApprovedAdvances")
  salaryAdvances          SalaryAdvance[]
  sales                   Sale[]                 @relation("Salesman")
  receivedTransfers       StockTransfer[]        @relation("ReceivedTransfers")
  ownedTickets            Ticket[]               @relation("TicketAdmin")
  assignedTickets         Ticket[]               @relation("AssignedTo")
  createdTickets          Ticket[]               @relation("CreatedTickets")
  previousAssignedTickets Ticket[]               @relation("PreviousAssignee")
  closureRequests         TicketClosureRequest[] @relation("ClosureRequestedBy")
  ticketHistoryActions    TicketHistory[]        @relation("TicketHistoryDoneBy")
  ticketMessages          TicketMessage[]        @relation("TicketMessageSender")
  vouchers                Voucher[]
  managedWorkLogs         WorkLog[]              @relation("AdminWorkLogs")
  workLogs                WorkLog[]
  leads                   Lead[]
  referredLeads           Lead[]                 @relation("ReferredBy")
  admin                   User?                  @relation("StaffAdmin", fields: [adminId], references: [id], map: "User_adminId_fkey")
  managedStaff            User[]                 @relation("StaffAdmin")
  branch                  Branch?                @relation(fields: [branchId], references: [id], map: "User_branchId_fkey")
  terminals               Terminal[]             @relation("TerminalToUser")
  dayCloseOpenings          DayClose[]             @relation("DayCloseOpenedBy")
  dayCloseOpeningApprovals  DayClose[]             @relation("DayCloseOpeningApprovedBy")
  dayCloseFinalizations     DayClose[]             @relation("DayCloseFinalizedBy")
  dayCloseExceptionApprovals DayClose[]            @relation("DayCloseExceptionApprovedBy")
  staffDayClosings        StaffDayClose[]
}

model Branch {
  id                Int                @id @default(autoincrement())
  name              String
  address           String?
  phone             String?
  email             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  invoiceSettings   Json?
  stockIncluded     Boolean            @default(true)
  invoiceTemplate   String?
  currencyCode      String?            @default("INR")
  currencySymbol    String?            @default("₹")
  attendance        Attendance[]
  barcodeSetting    BarcodeSetting?
  customers         Customer[]
  challans          DeliveryChallan[]
  expenses          Expense[]
  financialYears    FinancialYear[]
  leaveRequests     LeaveRequest[]
  missPunchRequests MissPunchRequest[]
  payments          Payment[]
  payrolls          Payroll[]
  productStocks     ProductStock[]
  purchases         Purchase[]
  quotations        Quotation[]
  salaryAdvances    SalaryAdvance[]
  sales             Sale[]
  outgoingTransfers StockTransfer[]    @relation("FromBranch")
  incomingTransfers StockTransfer[]    @relation("ToBranch")
  terminals         Terminal[]
  tickets           Ticket[]
  workLogs          WorkLog[]
  leads             Lead[]
  users             User[]
  dayCloses         DayClose[]
  customerVouchers  CustomerVoucher[]
  vouchers          Voucher[]
}

model CompanyProfile {
  id                      Int      @id @default(autoincrement())
  companyName             String
  address                 String?
  city                    String?
  state                   String?
  pincode                 String?
  phone                   String?
  email                   String?
  website                 String?
  registrationNumber      String?
  logoUrl                 String?
  currencyCode            String   @default("INR")
  currencySymbol          String   @default("₹")
  country                 String   @default("India")
  taxSystem               String   @default("GST")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  invoiceSettings         Json?
  bankId                  Int?
  dashboardImageUrl       String?
  gradientType            String   @default("linear")
  primaryColor            String   @default("#10b981")
  secondaryColor          String   @default("#059669")
  showOnlyLogoOnDashboard Boolean  @default(true)
  bank                    Bank?    @relation(fields: [bankId], references: [id])
}

model State {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                Int               @id @default(autoincrement())
  name              String
  phone             String?           @unique
  email             String?
  address           String?
  state             String?
  area              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  branchId          Int?
  city              String?
  gstin             String?
  partyType         String            @default("B2C")
  pincode           String?
  accessPermissions Json?
  password          String?
  role              String            @default("customer")
  username          String?           @unique
  advances          Advance?
  advanceHistory    AdvanceHistory[]
  branch            Branch?           @relation(fields: [branchId], references: [id])
  challans          DeliveryChallan[]
  payments          Payment[]
  quotations        Quotation[]
  sales             Sale[]
  tickets           Ticket[]
  customerVouchers  CustomerVoucher[]
}

model Advance {
  id          String   @id @default(cuid())
  customerId  Int      @unique
  totalAmount Decimal  @db.Decimal(10, 2)
  usedAmount  Decimal  @default(0) @db.Decimal(10, 2)
  balance     Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  notes       String?
  updatedAt   DateTime @default(now()) @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
}

model AdvanceHistory {
  id           String   @id @default(cuid())
  customerId   Int
  advanceId    String
  action       String
  amount       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  reference    String?
  createdAt    DateTime @default(now())
  date         DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id])
}

model Supplier {
  id            Int        @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  state         String?
  gstNumber     String?
  contactPerson String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  payments      Payment[]
  purchases     Purchase[]
}

model Category {
  id                   Int              @id @default(autoincrement())
  name                 String           @unique
  unitType             String?
  attributes           Json?            @default("[]")
  defaultLabelDesignId Int?
  defaultLabelDesign   BarcodeTemplate? @relation(fields: [defaultLabelDesignId], references: [id], onDelete: SetNull)
  products             Product[]
  productTypes         ProductType[]
  brands               Brand[]
}

model ProductType {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  genders    Json?     @default("[]")
  attributes Json?
  sizes      Json?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@unique([name, categoryId])
}

model Brand {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  barcode      String?   @unique
  categoryId   Int?
  categoryName String?
  categoryIds  Json?     @default("[]")
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id              Int                   @id @default(autoincrement())
  name            String
  brandId         Int?
  brandName       String?
  categoryId      Int?
  categoryName    String?
  productTypeId   Int?
  productTypeName String?
  gender          String?
  attributes      Json?
  size            String?
  sizeStocks      Json?
  price           Decimal               @db.Decimal(10, 2)
  brandPrices     Json?
  costPrice       Decimal?              @db.Decimal(10, 2)
  taxRate         Decimal               @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal?              @db.Decimal(5, 2)
  taxType         String?
  isTaxInclusive  Boolean               @default(false)
  hsnCode         String?
  warranty        Int?
  description     String?
  barcode         String?
  hasBarcode      Boolean               @default(false)
  minStockLevel   Int                   @default(5)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  maxDiscount     Decimal?              @db.Decimal(5, 2)
  minDiscount     Decimal?              @db.Decimal(5, 2)
  imageUrl        String?
  isActive        Boolean               @default(true)
  challanItems    DeliveryChallanItem[]
  brand           Brand?                @relation(fields: [brandId], references: [id])
  category        Category?             @relation(fields: [categoryId], references: [id])
  productType     ProductType?          @relation(fields: [productTypeId], references: [id])
  stocks          ProductStock[]
  purchaseItems   PurchaseItem[]
  quotationItems  QuotationItem[]
  saleItems       SaleItem[]
  transferItems   StockTransferItem[]
  leads           Lead[]
}

model ProductStock {
  id        Int     @id @default(autoincrement())
  branchId  Int
  productId Int
  quantity  Int     @default(0)
  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model Purchase {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String?
  supplierId      Int?
  purchaseDate    DateTime       @default(now())
  totalAmount     Decimal        @db.Decimal(10, 2)
  status          String         @default("completed")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paymentMethod   String?
  balanceAmount   Decimal        @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(10, 2)
  branchId        Int
  subTotal        Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(10, 2)
  financialYearId Int?
  branch          Branch         @relation(fields: [branchId], references: [id])
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]

  @@unique([branchId, invoiceNumber, financialYearId])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  size       String?
  quantity   Int
  unitCost   Decimal  @db.Decimal(10, 2)
  totalCost  Decimal  @db.Decimal(10, 2)
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model Sale {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String
  customerId      Int?
  saleDate        DateTime       @default(now())
  subTotal        Decimal        @db.Decimal(10, 2)
  taxAmount       Decimal        @db.Decimal(10, 2)
  totalAmount     Decimal        @db.Decimal(10, 2)
  roundOffAmount  Decimal        @default(0) @db.Decimal(10, 2)
  paymentMethod   String?
  status          String         @default("completed")
  isReturn        Boolean        @default(false)
  returnReason    String?
  originalInvoice String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  balanceAmount   Decimal        @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(10, 2)
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  branchId        Int
  salesmanId      Int?
  incentiveAmount Decimal        @default(0) @db.Decimal(10, 2)
  ewayBillDate    DateTime?
  ewayBillNumber  String?
  isB2B           Boolean        @default(false)
  placeOfSupply   String?
  transportMode   String?
  transporterId   String?
  transporterName String?
  vehicleNumber   String?
  isTaxInclusive  Boolean        @default(false)
  terminalId      Int?
  financialYearId Int?
  isInvoice       Boolean        @default(false)
  quotationId     Int?           @unique
  currencyCode    String?        @default("INR")
  exchangeRate    Decimal?       @default(1.0) @db.Decimal(10, 4)
  discount        Float          @default(0)
  advanceUsed     Decimal        @default(0) @db.Decimal(10, 2)
  description     String?
  deliveryCharge  Decimal        @default(0) @db.Decimal(10, 2)
  hasDeliveryCharge Boolean      @default(false)
  voucherCode     String?
  voucherDiscount Decimal        @default(0) @db.Decimal(10, 2)
  payments        Payment[]
  branch          Branch         @relation(fields: [branchId], references: [id])
  customer        Customer?      @relation(fields: [customerId], references: [id])
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])
  quotation       Quotation?     @relation("QuotationToInvoice", fields: [quotationId], references: [id])
  salesman        User?          @relation("Salesman", fields: [salesmanId], references: [id])
  terminal        Terminal?      @relation(fields: [terminalId], references: [id])
  items           SaleItem[]
  lead            Lead?          @relation("LeadToSale")
  customerVouchersIssued CustomerVoucher[] @relation("VoucherIssuedSale")
  customerVouchersRedeemed CustomerVoucher[] @relation("VoucherRedeemedSale")
  customerVoucherRedemptions CustomerVoucherRedemption[]

  @@unique([branchId, invoiceNumber, financialYearId])
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int
  productId       Int
  size            String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  originalUnitPrice Decimal? @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  voucherDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal @default(0) @db.Decimal(10, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  isTaxInclusive  Boolean @default(false)
  product         Product @relation(fields: [productId], references: [id])
  sale            Sale    @relation(fields: [saleId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Decimal  @db.Decimal(10, 2)
  category    String?
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model Payment {
  id          Int        @id @default(autoincrement())
  type        String
  amount      Decimal    @db.Decimal(10, 2)
  method      String
  reference   String?
  description String?
  paymentDate DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customerId  Int?
  saleId      Int?
  supplierId  Int?
  branchId    Int
  quotationId Int?
  branch      Branch     @relation(fields: [branchId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id])
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  sale        Sale?      @relation(fields: [saleId], references: [id])
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String
  customerId      Int?
  quotationDate   DateTime        @default(now())
  validUntil      DateTime?
  subTotal        Decimal         @db.Decimal(10, 2)
  taxAmount       Decimal         @db.Decimal(10, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  status          String          @default("DRAFT")
  notes           String?
  terms           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  branchId        Int
  isTaxInclusive  Boolean         @default(false)
  taxType         String?
  financialYearId Int?
  payments        Payment[]
  branch          Branch          @relation(fields: [branchId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  financialYear   FinancialYear?  @relation(fields: [financialYearId], references: [id])
  items           QuotationItem[]
  invoice         Sale?           @relation("QuotationToInvoice")
  lead            Lead?           @relation("LeadToQuotation")

  @@unique([branchId, quotationNumber, financialYearId])
}

model QuotationItem {
  id              Int       @id @default(autoincrement())
  quotationId     Int
  productId       Int
  quantity        Int
  unitPrice       Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(10, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(10, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  product         Product   @relation(fields: [productId], references: [id])
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model StockTransfer {
  id           Int                 @id @default(autoincrement())
  fromBranchId Int
  toBranchId   Int
  status       String              @default("PENDING")
  transferDate DateTime            @default(now())
  remarks      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  receivedById Int?
  receivedAt   DateTime?
  fromBranch   Branch              @relation("FromBranch", fields: [fromBranchId], references: [id])
  receivedBy   User?               @relation("ReceivedTransfers", fields: [receivedById], references: [id])
  toBranch     Branch              @relation("ToBranch", fields: [toBranchId], references: [id])
  items        StockTransferItem[]
}

model StockTransferItem {
  id         Int           @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int
  taxAmount  Decimal       @default(0) @db.Decimal(10, 2)
  taxPercent Decimal       @default(0) @db.Decimal(5, 2)
  totalCost  Decimal       @default(0) @db.Decimal(10, 2)
  unitCost   Decimal       @default(0) @db.Decimal(10, 2)
  product    Product       @relation(fields: [productId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
}

model BarcodeSetting {
  id               Int      @id @default(autoincrement())
  branchId         Int      @unique
  nameFontSize     Int      @default(20)
  priceFontSize    Int      @default(16)
  barcodeWidth     Float    @default(2)
  barcodeHeight    Int      @default(100)
  barcodeFontSize  Int      @default(18)
  alignment        String   @default("center")
  showName         Boolean  @default(true)
  showPrice        Boolean  @default(true)
  showBarcodeValue Boolean  @default(true)
  paperSize        String   @default("Single")
  columns          Int      @default(1)
  margin           Int      @default(10)
  labelWidth       Float    @default(40)
  labelHeight      Float    @default(20)
  paperWidth       Float    @default(210)
  columnGap        Float    @default(5)
  rowGap           Float    @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id])
}

model BarcodeTemplate {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  rawZpl      String     @db.Text
  labelWidth  Float?     @default(40)
  labelHeight Float?     @default(20)
  dpi         Int?       @default(203)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[]
}

model EmployeeProfile {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  designationId Int?
  departmentId  Int?
  joiningDate   DateTime     @default(now())
  basicSalary   Decimal      @default(0) @db.Decimal(10, 2)
  labourRule    String?
  nationalId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accountNumber String?
  bankName      String?
  branchName    String?
  employeeCode  String?      @unique
  ifscCode      String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  designation   Designation? @relation(fields: [designationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

model Designation {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  employees EmployeeProfile[]
}

model Department {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  employees EmployeeProfile[]
}

model Attendance {
  id        Int       @id @default(autoincrement())
  userId    Int
  date      DateTime  @default(now())
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("PRESENT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branchId  Int?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model LeaveRequest {
  id           Int        @id @default(autoincrement())
  userId       Int
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String     @default("PENDING")
  approvedById Int?
  leaveTypeId  Int?
  isHalfDay    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  branchId     Int?
  approvedBy   User?      @relation("LeaveApprover", fields: [approvedById], references: [id])
  branch       Branch?    @relation(fields: [branchId], references: [id])
  leaveType    LeaveType? @relation(fields: [leaveTypeId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model LeaveType {
  id           Int            @id @default(autoincrement())
  name         String
  isPaid       Boolean        @default(true)
  color        String         @default("#3B82F6")
  monthlyLimit Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  requests     LeaveRequest[]
}

model Payroll {
  id             Int             @id @default(autoincrement())
  userId         Int
  month          String
  year           Int
  basicSalary    Decimal         @db.Decimal(10, 2)
  allowances     Decimal         @default(0) @db.Decimal(10, 2)
  deductions     Decimal         @default(0) @db.Decimal(10, 2)
  netSalary      Decimal         @db.Decimal(10, 2)
  status         String          @default("GENERATED")
  fromDate       DateTime?
  toDate         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  voucherId      Int?
  branchId       Int?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  voucher        Voucher?        @relation(fields: [voucherId], references: [id])
  salaryAdvances SalaryAdvance[]
}

model Lead {
  id                   Int               @id(map: "Lead_pkey") @default(autoincrement())
  name                 String
  company              String?
  email                String?
  phone                String?
  source               String?
  status               String            @default("NEW")
  assignedTo           Int?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  address              String?
  budget               Decimal?          @db.Decimal(15, 2)
  followUpDate         DateTime?
  priority             String            @default("MEDIUM")
  productId            Int?
  quantity             Int?
  quotationId          Int?              @unique(map: "Lead_quotationId_key")
  saleId               Int?              @unique(map: "Lead_saleId_key")
  lastFollowUpDate     DateTime?
  nextFollowUpDate     DateTime?
  outcome              String?
  reminderFlag         Boolean           @default(false)
  branchId             Int?
  commissionAmount     Decimal?          @db.Decimal(15, 2)
  commissionPaid       Boolean           @default(false)
  commissionPercentage Decimal?          @db.Decimal(5, 2)
  negotiationAmount    Decimal?          @db.Decimal(15, 2)
  referredById         Int?
  tasks                CRMTask[]
  deals                Deal[]
  followUps            FollowUp[]
  activities           LeadActivity[]
  assignedUser         User?             @relation(fields: [assignedTo], references: [id], map: "Lead_assignedTo_fkey")
  branch               Branch?           @relation(fields: [branchId], references: [id], map: "Lead_branchId_fkey")
  product              Product?          @relation(fields: [productId], references: [id], map: "Lead_productId_fkey")
  quotation            Quotation?        @relation("LeadToQuotation", fields: [quotationId], references: [id], map: "Lead_quotationId_fkey")
  referredBy           User?             @relation("ReferredBy", fields: [referredById], references: [id], map: "Lead_referredById_fkey")
  sale                 Sale?             @relation("LeadToSale", fields: [saleId], references: [id], map: "Lead_saleId_fkey")
  referralPayments     ReferralPayment[]
}

model ReferralPayment {
  id                Int      @id(map: "ReferralPayment_pkey") @default(autoincrement())
  leadId            Int
  paymentDate       DateTime
  amountPaid        Decimal  @db.Decimal(15, 2)
  paymentMethod     String
  bankName          String?
  transactionNumber String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade, map: "ReferralPayment_leadId_fkey")
}

model FollowUp {
  id               Int       @id @default(autoincrement())
  leadId           Int
  date             DateTime
  notes            String?
  status           String    @default("PENDING")
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?
  outcome          String?
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id          Int      @id @default(autoincrement())
  leadId      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Deal {
  id           Int       @id @default(autoincrement())
  title        String
  value        Decimal   @db.Decimal(15, 2)
  stage        String    @default("PROSPECTING")
  closeDate    DateTime?
  probability  Int       @default(0)
  leadId       Int?
  assignedTo   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tasks        CRMTask[]
  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id])
}

model CRMTask {
  id           Int       @id @default(autoincrement())
  title        String
  dueDate      DateTime?
  status       String    @default("PENDING")
  priority     String    @default("MEDIUM")
  description  String?
  leadId       Int?
  dealId       Int?
  assignedTo   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  deal         Deal?     @relation(fields: [dealId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id])
}

model MissPunchRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  date         DateTime
  checkInTime  String?
  checkOutTime String?
  reason       String
  status       String    @default("PENDING")
  reviewedBy   Int?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  reviewer     User?     @relation("ReviewedMissPunch", fields: [reviewedBy], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

model SalaryAdvance {
  id                Int       @id @default(autoincrement())
  userId            Int
  amount            Decimal   @db.Decimal(10, 2)
  reason            String
  requestDate       DateTime  @default(now())
  status            String    @default("PENDING")
  approvedBy        Int?
  approvedAt        DateTime?
  deductedInPayroll Boolean   @default(false)
  payrollId         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  voucherId         Int?
  branchId          Int?
  approver          User?     @relation("ApprovedAdvances", fields: [approvedBy], references: [id])
  branch            Branch?   @relation(fields: [branchId], references: [id])
  payroll           Payroll?  @relation(fields: [payrollId], references: [id])
  user              User      @relation(fields: [userId], references: [id])
  voucher           Voucher?  @relation(fields: [voucherId], references: [id])
}

model AccountGroup {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  groupType String
  parentId  Int?
  isSystem  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parent    AccountGroup?  @relation("SubGroups", fields: [parentId], references: [id])
  subGroups AccountGroup[] @relation("SubGroups")
  ledgers   Ledger[]
}

model Ledger {
  id             Int                  @id @default(autoincrement())
  name           String               @unique
  groupId        Int
  openingBalance Decimal              @default(0) @db.Decimal(15, 2)
  balanceType    String               @default("DEBIT")
  isActive       Boolean              @default(true)
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  isSystem       Boolean              @default(false)
  creditEntries  JournalEntry[]       @relation("CreditLedger")
  debitEntries   JournalEntry[]       @relation("DebitLedger")
  group          AccountGroup         @relation(fields: [groupId], references: [id])
  postings       TransactionPosting[]
}

model TransactionPosting {
  id              Int      @id @default(autoincrement())
  transactionType String
  label           String?
  targetTable     String?
  role            String
  ledgerId        Int
  side            String   @default("CREDIT")
  postingMethod   String   @default("SUM")
  amountField     String?
  customFormula   String?
  condition       String?
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ledger          Ledger   @relation(fields: [ledgerId], references: [id])

  @@unique([transactionType, role])
}

model Voucher {
  id             Int             @id @default(autoincrement())
  voucherNumber  String          @unique
  voucherType    String
  date           DateTime
  narration      String?
  totalAmount    Decimal         @db.Decimal(15, 2)
  status         String          @default("POSTED")
  reference      String?
  createdBy      Int
  branchId       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        JournalEntry[]
  payrolls       Payroll[]
  salaryAdvances SalaryAdvance[]
  creator        User            @relation(fields: [createdBy], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model JournalEntry {
  id             Int       @id @default(autoincrement())
  voucherId      Int
  debitLedgerId  Int?
  creditLedgerId Int?
  amount         Decimal   @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime  @default(now())
  bankDate       DateTime?
  isReconciled   Boolean   @default(false)
  reconRemarks   String?
  creditLedger   Ledger?   @relation("CreditLedger", fields: [creditLedgerId], references: [id])
  debitLedger    Ledger?   @relation("DebitLedger", fields: [debitLedgerId], references: [id])
  voucher        Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model FinancialYear {
  id                Int               @id @default(autoincrement())
  name              String
  startDate         DateTime
  endDate           DateTime
  isClosed          Boolean           @default(false)
  isLocked          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  invoicePrefix     String            @default("INV")
  invoiceSequence   String            @default("001")
  branchId          Int?
  challanPrefix     String            @default("DC")
  challanSequence   String            @default("001")
  purchasePrefix    String            @default("PUR")
  purchaseSequence  String            @default("001")
  quotationPrefix   String            @default("QT")
  quotationSequence String            @default("001")
  challans          DeliveryChallan[]
  branch            Branch?           @relation(fields: [branchId], references: [id])
  purchases         Purchase[]
  quotations        Quotation[]
  sales             Sale[]

  @@unique([name, branchId])
}

model GSTSettings {
  id                   Int      @id @default(autoincrement())
  ewayBillUsername     String?
  ewayBillPassword     String?
  ewayBillThreshold    Decimal  @default(50000) @db.Decimal(10, 2)
  autoGenerateEwayBill Boolean  @default(false)
  defaultPlaceOfSupply String?
  invoicePrefix        String   @default("INV")
  challanPrefix        String   @default("DC")
  termsAndConditions   String?
  bankDetails          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  apiMode              String   @default("SANDBOX")
  autoGenerateEinvoice Boolean  @default(false)
  einvoiceClientId     String?
  einvoiceClientSecret String?
  einvoicePassword     String?
  einvoiceUsername     String?
  ewayBillClientId     String?
  ewayBillClientSecret String?
  gspName              String?  @default("CDSL")
}

model DeliveryChallan {
  id                Int                   @id @default(autoincrement())
  challanNumber     String
  customerId        Int?
  challanDate       DateTime              @default(now())
  transportMode     String?
  vehicleNumber     String?
  transporterName   String?
  transporterId     String?
  reasonForMovement String?
  placeOfSupply     String?
  dispatchFrom      String?
  dispatchTo        String?
  ewayBillNumber    String?
  ewayBillDate      DateTime?
  branchId          Int
  status            String                @default("pending")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  financialYearId   Int?
  branch            Branch                @relation(fields: [branchId], references: [id])
  customer          Customer?             @relation(fields: [customerId], references: [id])
  financialYear     FinancialYear?        @relation(fields: [financialYearId], references: [id])
  items             DeliveryChallanItem[]

  @@unique([branchId, challanNumber, financialYearId])
}

model DeliveryChallanItem {
  id          Int             @id @default(autoincrement())
  challanId   Int
  productId   Int
  quantity    Int
  hsnCode     String?
  description String?
  challan     DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
}

model Bank {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  accountNumber   String?
  ifscCode        String?
  branchName      String?
  address         String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  companyProfiles CompanyProfile[]
}

model WhatsAppSetting {
  id                Int      @id @default(autoincrement())
  apiKey            String?
  apiUrl            String   @default("http://whatsappapi.fastsmsindia.com/wapp/api/send")
  isActive          Boolean  @default(true)
  salesTemplate     String?
  quotationTemplate String?
  paymentTemplate   String?
  creditTemplate    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WhatsAppLog {
  id        Int      @id @default(autoincrement())
  mobile    String
  message   String
  status    String   @default("SENT")
  timestamp DateTime @default(now())
}

model Terminal {
  id           Int      @id @default(autoincrement())
  terminalCode String   @unique
  name         String
  branchId     Int?
  isActive     Boolean  @default(true)
  lastUsed     DateTime @default(now())
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
  branch       Branch?  @relation(fields: [branchId], references: [id])
  users        User[]   @relation("TerminalToUser")
  dayCloses    DayClose[]
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  senderId       Int
  receiverId     Int
  message        String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  receiver       User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  ticketId  String?
  user      User     @relation(fields: [userId], references: [id])
}

model WorkLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  adminId     Int?
  branchId    Int?
  date        DateTime
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User?    @relation("AdminWorkLogs", fields: [adminId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id                 String                 @id @default(uuid())
  ticketId           String                 @unique
  title              String
  description        String
  categoryName       String?
  categoryId         Int?
  priority           String
  status             String                 @default("Created")
  fileUrl            String?
  branchId           Int
  customerId         Int?
  assignedToId       Int?
  createdByRole      String
  slaStatus          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  resignReason       String?
  adminId            Int?
  createdById        Int?
  reassignReason     String?
  previousAssigneeId Int?
  admin              User?                  @relation("TicketAdmin", fields: [adminId], references: [id])
  assignedTo         User?                  @relation("AssignedTo", fields: [assignedToId], references: [id])
  branch             Branch                 @relation(fields: [branchId], references: [id])
  category           TicketCategory?        @relation(fields: [categoryId], references: [id])
  createdBy          User?                  @relation("CreatedTickets", fields: [createdById], references: [id])
  customer           Customer?              @relation(fields: [customerId], references: [id])
  previousAssignee   User?                  @relation("PreviousAssignee", fields: [previousAssigneeId], references: [id])
  closureRequests    TicketClosureRequest[]
  history            TicketHistory[]
  messages           TicketMessage[]
}

model TicketCategory {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  tickets Ticket[]
}

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  action    String
  message   String
  doneById  Int
  role      String
  createdAt DateTime @default(now())
  reason    String?
  doneBy    User     @relation("TicketHistoryDoneBy", fields: [doneById], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  message   String
  senderId  Int
  role      String
  createdAt DateTime @default(now())
  sender    User     @relation("TicketMessageSender", fields: [senderId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model TicketClosureRequest {
  id            String   @id @default(uuid())
  ticketId      String
  requestedById Int
  reason        String
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  requestedBy   User     @relation("ClosureRequestedBy", fields: [requestedById], references: [id])
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
}

model InvoiceSetting {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  settings  Json
  updatedAt DateTime @updatedAt
}

model DayClose {
  id                        Int             @id @default(autoincrement())
  branchId                  Int
  businessDate              DateTime        @db.Date
  status                    String          @default("NOT_OPENED") // NOT_OPENED, OPEN, CLOSING_PENDING, CLOSED, ADMIN_CLOSED
  terminalId                Int?

  // Day Opening
  openedById                Int?
  openedAt                  DateTime?
  openingCash               Decimal?        @db.Decimal(10, 2)
  previousClosingCash       Decimal?        @default(0) @db.Decimal(10, 2)
  additionalCashAdded       Decimal?        @default(0) @db.Decimal(10, 2)
  cashRemovedBeforeOpening  Decimal?        @default(0) @db.Decimal(10, 2)
  expectedOpeningCash       Decimal?        @default(0) @db.Decimal(10, 2)
  actualOpeningCash         Decimal?        @default(0) @db.Decimal(10, 2)
  openingDifference         Decimal?        @default(0) @db.Decimal(10, 2)
  openingDiscrepancyReason  String?
  openingApprovedById       Int?
  openingDenominations      Json?
  openingRemarks            String?

  // Daily Activity Verification & Exceptions
  verificationChecks        Json?
  verificationExceptions    Json?
  exceptionApprovedById     Int?
  exceptionApprovalReason   String?

  // Day Closing
  salesSummary              Json?
  closingExpectedCash       Decimal?        @db.Decimal(10, 2)
  physicalCash              Decimal?        @db.Decimal(10, 2)
  cashDifference            Decimal?        @db.Decimal(10, 2)
  closingDenominations      Json?
  notes                     String?
  finalizedById             Int?
  finalizedAt               DateTime?
  adjustments               Json?           @default("[]")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  branch                    Branch          @relation(fields: [branchId], references: [id])
  terminal                  Terminal?       @relation(fields: [terminalId], references: [id])
  openedBy                  User?           @relation("DayCloseOpenedBy", fields: [openedById], references: [id])
  openingApprovedBy         User?           @relation("DayCloseOpeningApprovedBy", fields: [openingApprovedById], references: [id])
  finalizedBy               User?           @relation("DayCloseFinalizedBy", fields: [finalizedById], references: [id])
  exceptionApprovedBy       User?           @relation("DayCloseExceptionApprovedBy", fields: [exceptionApprovedById], references: [id])
  staffClosings             StaffDayClose[]

  @@unique([branchId, businessDate])
}

model StaffDayClose {
  id             Int      @id @default(autoincrement())
  dayCloseId     Int
  userId         Int
  salesSummary   Json
  physicalCash   Decimal  @db.Decimal(10, 2)
  cashDifference Decimal  @default(0) @db.Decimal(10, 2)
  denomination   Json?
  notes          String?
  status         String   @default("SUBMITTED")
  submittedAt    DateTime @default(now())
  dayClose       DayClose @relation(fields: [dayCloseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@unique([dayCloseId, userId])
}

model CustomerVoucher {
  id                    Int                         @id @default(autoincrement())
  code                  String                      @unique
  name                  String
  type                  String                      // 'FIXED', 'PERCENTAGE', 'PURCHASE_REWARD'
  value                 Decimal                     @db.Decimal(10, 2)
  maximumDiscount       Decimal?                    @db.Decimal(10, 2)
  minimumPurchaseAmount Decimal                     @default(0) @db.Decimal(10, 2)
  issueDate             DateTime                    @default(now())
  expiryDate            DateTime?
  status                String                      @default("ACTIVE") // 'ACTIVE', 'INACTIVE', 'REDEEMED', 'EXPIRED', 'CANCELLED'
  customerId            Int?
  branchId              Int?
  issuedSaleId          Int?
  redeemedSaleId        Int?
  redeemedAt            DateTime?
  usageLimit            Int                         @default(1)
  usageCount            Int                         @default(0)
  description           String?
  createdBy             Int?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  customer              Customer?                   @relation(fields: [customerId], references: [id])
  branch                Branch?                     @relation(fields: [branchId], references: [id])
  issuedSale            Sale?                       @relation("VoucherIssuedSale", fields: [issuedSaleId], references: [id])
  redeemedSale          Sale?                       @relation("VoucherRedeemedSale", fields: [redeemedSaleId], references: [id])
  redemptions           CustomerVoucherRedemption[]

  @@index([code])
  @@index([status])
  @@index([customerId])
  @@index([branchId])
}

model CustomerVoucherRedemption {
  id             Int             @id @default(autoincrement())
  voucherId      Int
  saleId         Int
  customerId     Int?
  branchId       Int
  discountAmount Decimal         @db.Decimal(10, 2)
  redeemedAt     DateTime        @default(now())

  voucher        CustomerVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([saleId])
}

